// ───────────────────────── tags — ⑦ 태그 ─────────────────────────

/// ⑦ 태그 StepRun 버전의 머리 행(1:1)
model TagSet {
  id                  Int                     @id @default(autoincrement())
  stepRunId           Int                     @unique @map("step_run_id")
