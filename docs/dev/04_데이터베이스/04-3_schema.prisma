// autoStore M1 데이터베이스 스키마 (Prisma 7.10, PostgreSQL 14 이상)
// 짝 문서: 04-1_ERD.md (테이블 목적·컬럼 근거·상태 코드 대응표·통합 결정)
// 규칙: 모델 PascalCase 단수 + @@map(snake_case 단수), 필드 camelCase + @map(snake_case).
//       PK는 Int autoincrement(SERIAL). 원·엔 Int, 달러 Decimal(10,2), 환율 Decimal(12,4), 비율 Decimal(7,4).
//       시각은 Timestamptz(6). 상태·종류 값은 VarChar + CHECK(맨 아래 SQL). ON DELETE는 Restrict, 로그성 참조만 SetNull.
//       ON UPDATE는 모두 Restrict로 적었다(Prisma 기본값 Cascade를 쓰지 않는다). FK 이름은 '{역할_}{참조테이블}_id'.
// M1 테이블만 넣었다. M2 예정 테이블·컬럼은 04-1_ERD.md §6.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// ───────────────────────── step-engine — 후보·단계 실행·게이트 ─────────────────────────

/// 후보: 작업 단위(앵커 키 = 型番 또는 앵커 상품 + 색상) 한 건과 그 현재값
model Candidate {
  id                      Int                       @id @default(autoincrement())
  creationPath            String                    @map("creation_path") @db.VarChar(16)
  status                  String                    @default("WORKING") @db.VarChar(24)
  statusChangedAt         DateTime                  @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  excludedReason          String?                   @map("excluded_reason") @db.VarChar(24)
  sourceKeywordId         Int?                      @map("source_keyword_id")
  rakutenQuery            String?                   @map("rakuten_query") @db.VarChar(128)
  sourceUrl               String?                   @map("source_url") @db.VarChar(2048)
  anchorModelCode         String?                   @map("anchor_model_code") @db.VarChar(128)
  anchorItemCode          String?                   @map("anchor_item_code") @db.VarChar(128)
  anchorColorCode         String?                   @map("anchor_color_code") @db.VarChar(64)
  anchorFixedAt           DateTime?                 @map("anchor_fixed_at") @db.Timestamptz(6)
  itemCode                String?                   @map("item_code") @db.VarChar(128)
  selectedColor           String?                   @map("selected_color") @db.VarChar(128)
  gender                  String?                   @db.VarChar(8)
  genderSource            String?                   @map("gender_source") @db.VarChar(8)
  genderRecheckRequired   Boolean                   @default(false) @map("gender_recheck_required")
  leafCategoryId          String?                   @map("leaf_category_id") @db.VarChar(20)
  wholeCategoryName       String?                   @map("whole_category_name") @db.VarChar(500)
  noComparisonConfirmedAt DateTime?                 @map("no_comparison_confirmed_at") @db.Timestamptz(6)
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceKeyword           Keyword?                  @relation(fields: [sourceKeywordId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  statusHistory           CandidateStatusHistory[]
  steps                   CandidateStep[]
  stepRuns                StepRun[]
  gatePasses              GatePass[]
  stepChains              StepChain[]
  domesticPrices          DomesticPrice[]
  pricingCouponInputs     PricingCouponInput[]
  imageAssets             ImageAsset[]
  referenceInputs         ThumbnailReferenceInput[]
  tagCompetitorInputs     TagCompetitorInput[]
  callLogs                CallLog[]
  userActionLogs          UserActionLog[]

  @@index([status, statusChangedAt])
  @@map("candidate")
}

/// 후보 상태 전이 이력(추가만). §5.2 전이 라벨을 사유 코드로 남긴다
model CandidateStatusHistory {
  id             Int           @id @default(autoincrement())
  candidateId    Int           @map("candidate_id")
  fromStatus     String?       @map("from_status") @db.VarChar(24)
  toStatus       String        @map("to_status") @db.VarChar(24)
  reason         String        @db.VarChar(32)
  stepRunId      Int?          @map("step_run_id")
  gatePassId     Int?          @map("gate_pass_id")
  registrationId Int?          @map("registration_id")
  changedAt      DateTime      @default(now()) @map("changed_at") @db.Timestamptz(6)

  candidate      Candidate     @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stepRun        StepRun?      @relation(fields: [stepRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  gatePass       GatePass?     @relation(fields: [gatePassId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([candidateId, changedAt])
  @@map("candidate_status_history")
}

/// 후보·단계(②~⑨, ⑥-1~⑥-3 각각)마다 한 행: 현재 버전 포인터와 현재 단계 상태
model CandidateStep {
  id               Int       @id @default(autoincrement())
  candidateId      Int       @map("candidate_id")
  stepCode         String    @map("step_code") @db.VarChar(16)
  status           String    @default("NOT_RUN") @db.VarChar(16)
  currentStepRunId Int?      @map("current_step_run_id")
  lastVersion      Int       @default(0) @map("last_version")
  staleInputs      String[]  @default([]) @map("stale_inputs") @db.VarChar(64)
  staleSince       DateTime? @map("stale_since") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentStepRun   StepRun?  @relation(fields: [currentStepRunId, candidateId, stepCode], references: [id, candidateId, stepCode], onDelete: Restrict, onUpdate: Restrict)

  @@unique([candidateId, stepCode])
  @@map("candidate_step")
}

/// 단계 실행 한 번 = 단계의 한 버전(추가만). 산출물 테이블이 step_run_id로 이 행을 가리킨다
model StepRun {
  id                    Int                      @id @default(autoincrement())
  candidateId           Int                      @map("candidate_id")
  stepCode              String                   @map("step_code") @db.VarChar(16)
  version               Int
  executionMode         String                   @map("execution_mode") @db.VarChar(12)
  ownerAction           String?                  @map("owner_action") @db.VarChar(16)
  baseStepRunId         Int?                     @map("base_step_run_id")
  stepChainId           Int?                     @map("step_chain_id")
  settingsSnapshotId    Int                      @map("settings_snapshot_id")
  // 실행 시작 때 고정한 AI 엔진·모델·CLI 버전(v0.4, D-16). AI를 부르지 않는 단계는 셋 다 NULL. 트리거가 수정을 막는다
  aiEngine              String?                  @map("ai_engine") @db.VarChar(16)
  aiModel               String?                  @map("ai_model") @db.VarChar(100)
  aiCliVersion          String?                  @map("ai_cli_version") @db.VarChar(40)
  status                String                   @default("RUNNING") @db.VarChar(16)
  failureKind           String?                  @map("failure_kind") @db.VarChar(20)
  errorCode             String?                  @map("error_code") @db.VarChar(100)
  errorMessage          String?                  @map("error_message") @db.Text
  inputFingerprintStart String                   @map("input_fingerprint_start") @db.Char(64)
  inputFingerprintEnd   String?                  @map("input_fingerprint_end") @db.Char(64)
  rerunReasonInputs     String[]                 @default([]) @map("rerun_reason_inputs") @db.VarChar(64)
  waitingSince          DateTime?                @map("waiting_since") @db.Timestamptz(6)
  waitSecondsTotal      Int                      @default(0) @map("wait_seconds_total")
  startedAt             DateTime                 @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt               DateTime?                @map("ended_at") @db.Timestamptz(6)

  candidate             Candidate                @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // 바탕 버전은 같은 후보·같은 단계의 실행만(복합 자기 참조 FK)
  baseStepRun           StepRun?                 @relation("StepRun_baseStepRun", fields: [baseStepRunId, candidateId, stepCode], references: [id, candidateId, stepCode], onDelete: Restrict, onUpdate: Restrict)
  // 연속 실행 묶음은 같은 후보의 묶음만(복합 FK)
  stepChain             StepChain?               @relation(fields: [stepChainId, candidateId], references: [id, candidateId], onDelete: Restrict, onUpdate: Restrict)
  settingsSnapshot      SettingsSnapshot         @relation(fields: [settingsSnapshotId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  statusHistory         CandidateStatusHistory[]
  currentOf             CandidateStep[]
  derivedStepRuns       StepRun[]                @relation("StepRun_baseStepRun")
  inputs                StepRunInput[]           @relation("StepRunInput_stepRun")
  readByInputs          StepRunInput[]           @relation("StepRunInput_sourceStepRun")
  gatePasses            GatePass[]
  sourcingComparison    SourcingComparison?
  priceJudgement        PriceJudgement?
  categoryDecision      CategoryDecision?
  generationRuns        GenerationRun[]
  thumbnailReferences   ThumbnailReference[]
  thumbnailSelection    ThumbnailSelection?
  contentDraftCopy      ContentDraftCopy?
  contentDraftFact      ContentDraftFact?
  contentDraftFields    ContentDraftField[]
  contentDraftAssembly  ContentDraftAssembly?
  tagSet                TagSet?
  registration          Registration?
  uploadResult          UploadResult?
  callLogs              CallLog[]
  userActionLogs        UserActionLog[]

  @@unique([candidateId, stepCode, version])
  @@unique([id, candidateId, stepCode])
  @@map("step_run")
}

/// 단계 실행이 읽은 입력 항목별 출처와 값 해시
model StepRunInput {
  id               Int      @id @default(autoincrement())
  stepRunId        Int      @map("step_run_id")
  inputKey         String   @map("input_key") @db.VarChar(64)
  sourceType       String   @map("source_type") @db.VarChar(12)
  sourceStepRunId  Int?     @map("source_step_run_id")
  isStartCondition Boolean  @map("is_start_condition")
  valueHash        String   @map("value_hash") @db.Char(64)

  stepRun          StepRun  @relation("StepRunInput_stepRun", fields: [stepRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceStepRun    StepRun? @relation("StepRunInput_sourceStepRun", fields: [sourceStepRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([stepRunId, inputKey])
  @@map("step_run_input")
}

/// G2·G3 통과 기록과 게이트 지문(추가만)
model GatePass {
  id               Int                      @id @default(autoincrement())
  candidateId      Int                      @map("candidate_id")
  gate             String                   @db.VarChar(2)
  fingerprint      String                   @db.Char(64)
  fingerprintBasis Json                     @map("fingerprint_basis")
  basisStepRunId   Int                      @map("basis_step_run_id")
  basisStepCode    String                   @map("basis_step_code") @db.VarChar(16)
  passedAt         DateTime                 @default(now()) @map("passed_at") @db.Timestamptz(6)

  candidate        Candidate                @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // 근거 실행은 같은 후보의 정해진 단계(G2 → PRICING, G3 → THUMBNAIL, CHECK)만(복합 FK)
  basisStepRun     StepRun                  @relation(fields: [basisStepRunId, candidateId, basisStepCode], references: [id, candidateId, stepCode], onDelete: Restrict, onUpdate: Restrict)
  statusHistory    CandidateStatusHistory[]

  @@index([candidateId, gate, passedAt(sort: Desc)])
  @@map("gate_pass")
}

/// '여기부터 연속 실행'·'재실행 필요 단계 모두 실행' 한 번의 묶음
model StepChain {
  id            Int       @id @default(autoincrement())
  candidateId   Int       @map("candidate_id")
  kind          String    @db.VarChar(16)
  startStepCode String?   @map("start_step_code") @db.VarChar(16)
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime? @map("ended_at") @db.Timestamptz(6)
  stopReason    String?   @map("stop_reason") @db.VarChar(24)
  stopStepCode  String?   @map("stop_step_code") @db.VarChar(16)
  skippedStepCodes String[] @default([]) @map("skipped_step_codes") @db.VarChar(16)

  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stepRuns      StepRun[]

  @@unique([id, candidateId])
  @@map("step_chain")
}

// ───────────────────────── keywords — ① 키워드 ─────────────────────────

/// 데이터랩 버튼 수집·붙여넣기 한 번의 결과 묶음
model KeywordSnapshot {
  id            Int       @id @default(autoincrement())
  method        String    @db.VarChar(8)
  collectedAt   DateTime  @default(now()) @map("collected_at") @db.Timestamptz(6)
  requestedCids String[]  @default([]) @map("requested_cids") @db.VarChar(16)
  periodStart   DateTime? @map("period_start") @db.Date
  periodEnd     DateTime? @map("period_end") @db.Date
  rankLimit     Int?      @map("rank_limit")
  responseRange String?   @map("response_range") @db.VarChar(40)
  rangeMatched  Boolean?  @map("range_matched")
  status        String    @db.VarChar(12)
  abortReason   String?   @map("abort_reason") @db.VarChar(20)
  httpStatus    Int?      @map("http_status") @db.SmallInt

  keywords      Keyword[]

  @@map("keyword_snapshot")
}

/// 스냅샷 안의 순위·키워드 한 줄과 G1 선택 기록
model Keyword {
  id                Int             @id @default(autoincrement())
  keywordSnapshotId Int             @map("keyword_snapshot_id")
  cid               String?         @db.VarChar(16)
  rank              Int
  keyword           String          @db.VarChar(100)
  excludedReason    String?         @map("excluded_reason") @db.VarChar(12)
  selectedAt        DateTime?       @map("selected_at") @db.Timestamptz(6)

  keywordSnapshot   KeywordSnapshot @relation(fields: [keywordSnapshotId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  candidates        Candidate[]

  @@unique([keywordSnapshotId, cid, rank])
  @@map("keyword")
}

// ───────────────────────── sourcing — ② 라쿠텐 소싱 ─────────────────────────

/// 라쿠텐 상품 페이지 JSON을 한 번 읽고 파싱한 스냅샷(추가만)
model RakutenItem {
  id                  Int                     @id @default(autoincrement())
  itemCode            String                  @map("item_code") @db.VarChar(128)
  shopCode            String                  @map("shop_code") @db.VarChar(64)
  shopName            String?                 @map("shop_name") @db.VarChar(255)
  itemName            String                  @map("item_name") @db.Text
  itemUrl             String                  @map("item_url") @db.VarChar(2048)
  modelCode           String?                 @map("model_code") @db.VarChar(128)
  modelCodeNorm       String?                 @map("model_code_norm") @db.VarChar(128)
  entrySource         String                  @map("entry_source") @db.VarChar(8)
  fetchReason         String                  @map("fetch_reason") @db.VarChar(16)
  collectedAt         DateTime                @map("collected_at") @db.Timestamptz(6)
  genreId             Int?                    @map("genre_id")
  genreSource         String                  @map("genre_source") @db.VarChar(16)
  genrePath           String?                 @map("genre_path") @db.VarChar(500)
  productType         String?                 @map("product_type") @db.VarChar(64)
  backOrderFlag       Boolean?                @map("back_order_flag")
  unlimitedInventory  Boolean?                @map("unlimited_inventory")
  allSkuSamePrice     Boolean?                @map("all_sku_same_price")
  saleStartsAt        DateTime?               @map("sale_starts_at") @db.Timestamptz(6)
  saleEndsAt          DateTime?               @map("sale_ends_at") @db.Timestamptz(6)
  descriptionHtml     String?                 @map("description_html") @db.Text
  descriptionText     String?                 @map("description_text") @db.Text
  attributes          Json?
  variantSelectors    Json?                   @map("variant_selectors")
  imageUrls           Json                    @default("[]") @map("image_urls")
  manualCheckRequired Boolean                 @default(false) @map("manual_check_required")
  manualCheckNote     String?                 @map("manual_check_note") @db.VarChar(500)
  rawFilePath         String?                 @map("raw_file_path") @db.VarChar(1024)
  rawFileSha256       String?                 @map("raw_file_sha256") @db.Char(64)
  rawFileBytes        Int?                    @map("raw_file_bytes")

  skus                RakutenSku[]
  comparisonRows      SourcingComparisonRow[]
  selectedBy          SourcingComparison[]
  priceJudgements     PriceJudgement[]

  // price_judgement (rakuten_item_id, rakuten_page_collected_at) 복합 FK의 대상
  @@unique([id, collectedAt])
  @@map("rakuten_item")
}

/// rakuten_item 스냅샷 하나의 SKU(색상·사이즈·폭) 행
model RakutenSku {
  id                   Int                     @id @default(autoincrement())
  rakutenItemId        Int                     @map("rakuten_item_id")
  variantId            String                  @map("variant_id") @db.VarChar(64)
  colorLabel           String?                 @map("color_label") @db.VarChar(128)
  colorCode            String?                 @map("color_code") @db.VarChar(64)
  sizeLabel            String?                 @map("size_label") @db.VarChar(64)
  sizeMm               Int?                    @map("size_mm") @db.SmallInt
  widthLabel           String?                 @map("width_label") @db.VarChar(64)
  taxIncludedPriceYen  Int?                    @map("tax_included_price_yen")
  quantity             Int?
  hidden               Boolean                 @default(false)
  backOrder            Boolean?                @map("back_order")
  stockCondition       String?                 @map("stock_condition") @db.VarChar(32)
  articleNumber        String?                 @map("article_number") @db.VarChar(32)
  postageIncluded      Boolean?                @map("postage_included")
  singleItemShipping   Boolean?                @map("single_item_shipping")
  selectorValues       Json                    @map("selector_values")
  attributes           Json?

  rakutenItem          RakutenItem             @relation(fields: [rakutenItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  representativeOfRows SourcingComparisonRow[]
  judgementSizes       PriceJudgementSize[]

  @@unique([rakutenItemId, variantId])
  @@map("rakuten_sku")
}

/// ② 소싱 StepRun 버전 하나의 산출물 머리 행(1:1)
model SourcingComparison {
  id                       Int                     @id @default(autoincrement())
  stepRunId                Int                     @unique @map("step_run_id")
  baseSourcingComparisonId Int?                    @map("base_sourcing_comparison_id")
  action                   String                  @db.VarChar(16)
  searchKeyword            String?                 @map("search_keyword") @db.VarChar(128)
  sourceUrl                String?                 @map("source_url") @db.VarChar(2048)
  anchorInputMethod        String?                 @map("anchor_input_method") @db.VarChar(16)
  anchorItemCode           String?                 @map("anchor_item_code") @db.VarChar(128)
  anchorModelCode          String?                 @map("anchor_model_code") @db.VarChar(128)
  anchorModelCodeNorm      String?                 @map("anchor_model_code_norm") @db.VarChar(128)
  anchorColorCode          String?                 @map("anchor_color_code") @db.VarChar(64)
  anchorColorLabel         String?                 @map("anchor_color_label") @db.VarChar(128)
  comparisonPerformed      Boolean                 @default(true) @map("comparison_performed")
  // 비교를 하지 않은 버전(URL로 만들기, 그 재조회)의 소싱 선택. 비교를 한 버전은 NULL이고 선택은 행(is_selected)에 있다
  selectedRakutenItemId    Int?                    @map("selected_rakuten_item_id")
  shippingYen              Int?                    @map("shipping_yen")
  shippingSource           String?                 @map("shipping_source") @db.VarChar(20)
  detectedGender           String?                 @map("detected_gender") @db.VarChar(8)
  genderBasis              String?                 @map("gender_basis") @db.VarChar(16)
  ownerGender              String?                 @map("owner_gender") @db.VarChar(8)
  childSizeSuspect         Boolean?                @map("child_size_suspect")
  genreScope               String?                 @map("genre_scope") @db.VarChar(16)
  adultProductConfirmedAt  DateTime?               @map("adult_product_confirmed_at") @db.Timestamptz(6)
  params                   Json
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  stepRun                  StepRun                 @relation(fields: [stepRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  selectedRakutenItem      RakutenItem?            @relation(fields: [selectedRakutenItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  baseComparison           SourcingComparison?     @relation("SourcingComparison_baseComparison", fields: [baseSourcingComparisonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  derivedComparisons       SourcingComparison[]    @relation("SourcingComparison_baseComparison")
  rows                     SourcingComparisonRow[]

  @@map("sourcing_comparison")
}

/// 비교표(RK-09) 한 행 = 라쿠텐 상품 하나
model SourcingComparisonRow {
  id                         Int                @id @default(autoincrement())
  sourcingComparisonId       Int                @map("sourcing_comparison_id")
  rowSource                  String             @map("row_source") @db.VarChar(8)
  searchRank                 Int?               @map("search_rank") @db.SmallInt
  itemCode                   String             @map("item_code") @db.VarChar(128)
  shopCode                   String             @map("shop_code") @db.VarChar(64)
  shopName                   String?            @map("shop_name") @db.VarChar(255)
  itemName                   String             @map("item_name") @db.Text
  itemUrl                    String             @map("item_url") @db.VarChar(2048)
  apiItemPriceYen            Int?               @map("api_item_price_yen")
  apiItemPriceMin3Yen        Int?               @map("api_item_price_min3_yen")
  apiPointRate               Int?               @map("api_point_rate") @db.SmallInt
  apiPostageFlag             Int?               @map("api_postage_flag") @db.SmallInt
  reviewCount                Int?               @map("review_count")
  reviewAverage              Decimal?           @map("review_average") @db.Decimal(3, 2)
  shipOverseas               Boolean?           @map("ship_overseas")
  apiCollectedAt             DateTime?          @map("api_collected_at") @db.Timestamptz(6)
  modelCodeNorm              String?            @map("model_code_norm") @db.VarChar(128)
  colorCode                  String?            @map("color_code") @db.VarChar(64)
  anchorMatch                String?            @map("anchor_match") @db.VarChar(16)
  janMatch                   Boolean?           @map("jan_match")
  makerModelMatch            Boolean?           @map("maker_model_match")
  aiMatch                    Json?              @map("ai_match")
  ownerMatchDecision         String?            @map("owner_match_decision") @db.VarChar(16)
  fetchOrder                 Int?               @map("fetch_order") @db.SmallInt
  isVerified                 Boolean            @default(false) @map("is_verified")
  rakutenItemId              Int?               @map("rakuten_item_id")
  manualCheckRequired        Boolean            @default(false) @map("manual_check_required")
