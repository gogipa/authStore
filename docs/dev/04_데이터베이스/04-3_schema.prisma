  versionSupported Boolean? @map("version_supported")
  authStatus       String   @map("auth_status") @db.VarChar(16)
  smokeStatus      String   @map("smoke_status") @db.VarChar(16)
  model            String?  @db.VarChar(100)
  latencyMs        Int?     @map("latency_ms")
  errorCode        String?  @map("error_code") @db.VarChar(100)
  errorMessage     String?  @map("error_message") @db.Text
  checkedAt        DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@index([engineCode, checkedAt(sort: Desc)])
  @@map("ai_cli_check")
}

