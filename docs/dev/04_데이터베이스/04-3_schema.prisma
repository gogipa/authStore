  pointBaseAmountYen         Int?               @map("point_base_amount_yen")
  pointsBasePt               Int?               @map("points_base_pt")
  pointsItemPt               Int?               @map("points_item_pt")
  pointsShopEventPt          Int?               @map("points_shop_event_pt")
  pointsSpuPt                Int?               @map("points_spu_pt")
  pointsTotalPt              Int?               @map("points_total_pt")
  effectivePriceYen          Int?               @map("effective_price_yen")
  isSelected                 Boolean            @default(false) @map("is_selected")
