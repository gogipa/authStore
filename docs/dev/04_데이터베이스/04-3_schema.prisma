  registrationId Int?          @map("registration_id")
  stepCode       String?       @map("step_code") @db.VarChar(16)
  gate           String?       @db.VarChar(2)
  detail         Json?

  candidate      Candidate?    @relation(fields: [candidateId], references: [id], onDelete: SetNull, onUpdate: Restrict)
