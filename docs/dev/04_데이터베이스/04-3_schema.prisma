  @@map("content_draft_field")
}

/// ⑥-3 고시·사양·고지·HTML StepRun 버전의 조립 결과(1:1)
model ContentDraftAssembly {
  id                        Int      @id @default(autoincrement())
  stepRunId                 Int      @unique @map("step_run_id")
  productName               String   @map("product_name") @db.VarChar(255)
  noticeFields              Json     @map("notice_fields")
  noticeSizesMm             Int[]    @map("notice_sizes_mm") @db.SmallInt
  originAreaCode            String   @map("origin_area_code") @db.VarChar(20)
  originAreaPlural          Boolean  @default(false) @map("origin_area_plural")
  originAreaContent         String?  @map("origin_area_content") @db.VarChar(200)
