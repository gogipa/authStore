  wholeCategoryName           String?   @map("whole_category_name") @db.VarChar(500)
  genderPathMatch             Boolean?  @map("gender_path_match")
  exceptionalCategories       Json?     @map("exceptional_categories")
  exceptionDecision           String?   @map("exception_decision") @db.VarChar(16)
  blockReason                 String?   @map("block_reason") @db.VarChar(500)
