  evidenceQuote        String?     @map("evidence_quote") @db.Text
  evidenceUrl          String?     @map("evidence_url") @db.VarChar(2048)
  evidenceImageAssetId Int?        @map("evidence_image_asset_id")
  basisItemCode        String?     @map("basis_item_code") @db.VarChar(128)
  basisSha256          String?     @map("basis_sha256") @db.Char(64)
  ownerConfirmedAt     DateTime?   @map("owner_confirmed_at") @db.Timestamptz(6)
  choicePending        Boolean     @default(false) @map("choice_pending")
  recheckReason        String?     @map("recheck_reason") @db.VarChar(24)
  recheckResolvedAt    DateTime?   @map("recheck_resolved_at") @db.Timestamptz(6)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
