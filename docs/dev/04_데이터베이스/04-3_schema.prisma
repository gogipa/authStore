// ───────────────────────── pricing — ③ 가격·마진 판정 ─────────────────────────

/// 후보의 국내 기준가(P_ref) 입력 이력(추가만)
model DomesticPrice {
  id              Int              @id @default(autoincrement())
  candidateId     Int              @map("candidate_id")
  pRefKrw         Int              @map("p_ref_krw")
  sourceKind      String           @map("source_kind") @db.VarChar(16)
  sourceLabel     String?          @map("source_label") @db.VarChar(100)
  sourceUrl       String?          @map("source_url") @db.VarChar(2048)
  enteredAt       DateTime         @default(now()) @map("entered_at") @db.Timestamptz(6)

  candidate       Candidate        @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  priceJudgements PriceJudgement[]

  @@index([candidateId, enteredAt(sort: Desc)])
  @@map("domestic_price")
}

/// 비교표 행이 없는 후보(URL 후보)의 ③ 쿠폰 금액 입력 이력(추가만, ③ 시작 조건)
model PricingCouponInput {
  id          Int       @id @default(autoincrement())
  candidateId Int       @map("candidate_id")
  couponYen   Int       @map("coupon_yen")
  enteredAt   DateTime  @default(now()) @map("entered_at") @db.Timestamptz(6)

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([candidateId, enteredAt(sort: Desc)])
  @@map("pricing_coupon_input")
}

/// ③ 판정 StepRun 버전 하나의 판정 스냅샷 머리 행(1:1)
model PriceJudgement {
  id                     Int                  @id @default(autoincrement())
  stepRunId              Int                  @unique @map("step_run_id")
  skuPriceSource         String               @map("sku_price_source") @db.VarChar(16)
  rakutenItemId          Int?                 @map("rakuten_item_id")
  rakutenPageCollectedAt DateTime?            @map("rakuten_page_collected_at") @db.Timestamptz(6)
  domesticPriceId        Int                  @map("domestic_price_id")
  couponYen              Int                  @default(0) @map("coupon_yen")
  shippingYen            Int                  @map("shipping_yen")
  shippingEstimated      Boolean              @map("shipping_estimated")
  costFxRateId           Int                  @map("cost_fx_rate_id")
  customsJpyFxRateId     Int                  @map("customs_jpy_fx_rate_id")
  customsUsdFxRateId     Int                  @map("customs_usd_fx_rate_id")
  forwarderRateTableId   Int?                 @map("forwarder_rate_table_id")
  chargeableWeightKg     Decimal?             @map("chargeable_weight_kg") @db.Decimal(6, 3)
  cShipIntlKrw           Int?                 @map("c_ship_intl_krw")
  cFwdKrw                Int                  @map("c_fwd_krw")
  fwdCouponKrw           Int                  @default(0) @map("fwd_coupon_krw")
  fwdAssumed             Boolean              @map("fwd_assumed")
  dutyFreeLimitYen       Int?                 @map("duty_free_limit_yen")
  vatMode                String               @map("vat_mode") @db.VarChar(1)
  pricingRule            String               @map("pricing_rule") @db.VarChar(20)
  targetMarginRate       Decimal              @map("target_margin_rate") @db.Decimal(7, 4)
  minProfitKrw           Int                  @map("min_profit_krw")
  params                 Json
  isSaleCandidate        Boolean              @map("is_sale_candidate")
  sellableSizeCount      Int                  @map("sellable_size_count") @db.SmallInt
  salePriceKrw           Int?                 @map("sale_price_krw")
  exclusionReason        String?              @map("exclusion_reason") @db.VarChar(500)
  judgedAt               DateTime             @default(now()) @map("judged_at") @db.Timestamptz(6)

  stepRun                StepRun              @relation(fields: [stepRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // 수집 시각 사본이 원본 스냅샷과 같음을 복합 FK로 보장
  rakutenItem            RakutenItem?         @relation(fields: [rakutenItemId, rakutenPageCollectedAt], references: [id, collectedAt], onDelete: Restrict, onUpdate: Restrict)
  domesticPrice          DomesticPrice        @relation(fields: [domesticPriceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  costFxRate             FxRate               @relation("PriceJudgement_costFxRate", fields: [costFxRateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customsJpyFxRate       FxRate               @relation("PriceJudgement_customsJpyFxRate", fields: [customsJpyFxRateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customsUsdFxRate       FxRate               @relation("PriceJudgement_customsUsdFxRate", fields: [customsUsdFxRateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  forwarderRateTable     ForwarderRateTable?  @relation(fields: [forwarderRateTableId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sizes                  PriceJudgementSize[]
  registrations          Registration[]

  @@map("price_judgement")
}

/// 판정 스냅샷의 사이즈별 비용 분해·면세·최소 판매가·판매 가능
model PriceJudgementSize {
  id                Int            @id @default(autoincrement())
  priceJudgementId  Int            @map("price_judgement_id")
  sizeMm            Int            @map("size_mm") @db.SmallInt
  rakutenSkuId      Int?           @map("rakuten_sku_id")
  skuPriceYen       Int            @map("sku_price_yen")
  cGoodsKrw         Int            @map("c_goods_krw")
  vUsd              Decimal        @map("v_usd") @db.Decimal(10, 2)
  isDutyFree        Boolean        @map("is_duty_free")
  twoPairTaxable    Boolean        @map("two_pair_taxable")
  isBoundary        Boolean        @map("is_boundary")
  customsValueKrw   Int?           @map("customs_value_krw")
  cTaxKrw           Int            @default(0) @map("c_tax_krw")
  pMinKrw           Int?           @map("p_min_krw")
  optionPriceKrw    Int            @default(0) @map("option_price_krw")
  sizeSalePriceKrw  Int?           @map("size_sale_price_krw")
  cMktKrw           Int?           @map("c_mkt_krw")
  vatAKrw           Int?           @map("vat_a_krw")
  vatBKrw           Int?           @map("vat_b_krw")
  profitAKrw        Int?           @map("profit_a_krw")
  profitBKrw        Int?           @map("profit_b_krw")
  marginRateA       Decimal?       @map("margin_rate_a") @db.Decimal(7, 4)
  pointsReferencePt Int?           @map("points_reference_pt")
  isSellable        Boolean        @map("is_sellable")
  unsellableReason  String?        @map("unsellable_reason") @db.VarChar(20)

  priceJudgement    PriceJudgement @relation(fields: [priceJudgementId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rakutenSku        RakutenSku?    @relation(fields: [rakutenSkuId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([priceJudgementId, sizeMm])
  @@map("price_judgement_size")
}

/// 원가 환율·과세환율의 수집·수동 입력 기록(추가만)
model FxRate {
  id                   Int              @id @default(autoincrement())
  rateKind             String           @map("rate_kind") @db.VarChar(8)
  currency             String           @db.VarChar(3)
  rateValue            Decimal          @map("rate_value") @db.Decimal(12, 4)
  unit                 Int              @db.SmallInt
  source               String           @db.VarChar(16)
  sourceNote           String?          @map("source_note") @db.VarChar(200)
  referenceAt          DateTime         @map("reference_at") @db.Timestamptz(6)
  collectedAt          DateTime         @default(now()) @map("collected_at") @db.Timestamptz(6)
  rawResponse          Json?            @map("raw_response")

  costJudgements       PriceJudgement[] @relation("PriceJudgement_costFxRate")
  customsJpyJudgements PriceJudgement[] @relation("PriceJudgement_customsJpyFxRate")
  customsUsdJudgements PriceJudgement[] @relation("PriceJudgement_customsUsdFxRate")

  @@index([rateKind, currency, referenceAt(sort: Desc)])
  @@map("fx_rate")
}

// ───────────────────────── category — ④ 카테고리 ─────────────────────────

/// ④ 카테고리 StepRun 버전 하나의 산출물(1:1)
model CategoryDecision {
