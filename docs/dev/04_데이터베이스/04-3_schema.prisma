/// 외부 HTTP·AI 호출 1회당 1행. 비공식 수집 기록·하루 조회 상한·차단 휴지의 단일 원본
model CallLog {
  id           Int        @id @default(autoincrement())
  calledAt     DateTime   @map("called_at") @db.Timestamptz(6)
  kstDate      DateTime   @map("kst_date") @db.Date
  target       String     @db.VarChar(30)
  httpMethod   String?    @map("http_method") @db.VarChar(10)
  host         String?    @db.VarChar(255)
  urlMasked    String?    @map("url_masked") @db.VarChar(2048)
  httpStatus   Int?       @map("http_status") @db.SmallInt
  succeeded    Boolean?
  errorCode    String?    @map("error_code") @db.VarChar(100)
  errorMessage String?    @map("error_message") @db.Text
  itemCount    Int?       @map("item_count")
  durationMs   Int?       @map("duration_ms")
  traceId      String?    @map("trace_id") @db.VarChar(100)
  candidateId  Int?       @map("candidate_id")
  stepRunId    Int?       @map("step_run_id")

  candidate    Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  stepRun      StepRun?   @relation(fields: [stepRunId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([kstDate, target])
  @@map("call_log")
}

