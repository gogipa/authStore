// ───────────────────────── common — 이미지 파일 메타 ─────────────────────────

/// 이미지 파일 1개의 메타데이터(파일은 사용자 데이터 폴더, 추가만)
model ImageAsset {
  id                      Int                       @id @default(autoincrement())
  kind                    String                    @db.VarChar(16)
  filePath                String                    @map("file_path") @db.VarChar(1024)
  sha256                  String                    @db.Char(64)
  byteSize                Int                       @map("byte_size")
  mimeType                String                    @map("mime_type") @db.VarChar(32)
  width                   Int
  height                  Int
  sourceSection           String?                   @map("source_section") @db.VarChar(20)
  sourceUrl               String?                   @map("source_url") @db.VarChar(2048)
  sourceItemCode          String?                   @map("source_item_code") @db.VarChar(128)
  sourceShopCode          String?                   @map("source_shop_code") @db.VarChar(64)
  sourceModelCodeNorm     String?                   @map("source_model_code_norm") @db.VarChar(128)
  sourceColorCode         String?                   @map("source_color_code") @db.VarChar(64)
  collectedAt             DateTime?                 @map("collected_at") @db.Timestamptz(6)
  usageRight              String                    @default("REFERENCE_ONLY") @map("usage_right") @db.VarChar(16)
  candidateId             Int?                      @map("candidate_id")
  derivedFromImageAssetId Int?                      @map("derived_from_image_asset_id")
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  candidate               Candidate?                @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  derivedFrom             ImageAsset?               @relation("ImageAsset_derivedFrom", fields: [derivedFromImageAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  derivatives             ImageAsset[]              @relation("ImageAsset_derivedFrom")
  generationRun           GenerationRun?
  thumbnailReferences     ThumbnailReference[]
  referenceInputs         ThumbnailReferenceInput[]
  selectionImages         ThumbnailSelectionImage[]
  evidenceFields          ContentDraftField[]
  uploadedImage           UploadedImage?

  @@map("image_asset")
}

// ───────────────────────── thumbnails — ⑤ 썸네일 ─────────────────────────

/// AI 썸네일 생성 시도 1회(결과 이미지 0~1장)
model GenerationRun {
  id                 Int         @id @default(autoincrement())
  stepRunId          Int         @map("step_run_id")
  slotNo             Int         @map("slot_no") @db.SmallInt
  attemptNo          Int         @map("attempt_no") @db.SmallInt
  triggerType        String      @map("trigger_type") @db.VarChar(16)
  prompt             String      @db.Text
  promptAdjusted     Boolean     @default(false) @map("prompt_adjusted")
  faceOption         String      @map("face_option") @db.VarChar(16)
  requestedSizePx    Int         @map("requested_size_px")
  provider           String      @db.VarChar(16)
  model              String      @db.VarChar(100)
  providerVersion    String?     @map("provider_version") @db.VarChar(40)
  referenceSetSha256 String      @map("reference_set_sha256") @db.Char(64)
  status             String      @db.VarChar(16)
  refusalReason      String?     @map("refusal_reason") @db.Text
  errorMessage       String?     @map("error_message") @db.Text
  resultImageAssetId Int?        @unique @map("result_image_asset_id")
  startedAt          DateTime    @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt         DateTime?   @map("finished_at") @db.Timestamptz(6)

  stepRun            StepRun     @relation(fields: [stepRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resultImage        ImageAsset? @relation(fields: [resultImageAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([stepRunId, slotNo, attemptNo])
  @@map("generation_run")
}

/// ⑤ 버전마다 오너가 고른 레퍼런스 1~3장과 '사람·얼굴 없음' 확인
model ThumbnailReference {
  id                  Int        @id @default(autoincrement())
  stepRunId           Int        @map("step_run_id")
  imageAssetId        Int        @map("image_asset_id")
  sortOrder           Int        @map("sort_order") @db.SmallInt
  noPersonConfirmedAt DateTime   @map("no_person_confirmed_at") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  stepRun             StepRun    @relation(fields: [stepRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  imageAsset          ImageAsset @relation(fields: [imageAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([stepRunId, imageAssetId])
  @@unique([stepRunId, sortOrder])
  @@map("thumbnail_reference")
}

/// 후보의 레퍼런스 선택 입력 이력(추가만). 같은 input_no 행들이 선택 한 번(1~3장)이고, 최신 input_no가 현재 선택
model ThumbnailReferenceInput {
  id                  Int        @id @default(autoincrement())
  candidateId         Int        @map("candidate_id")
  inputNo             Int        @map("input_no")
  imageAssetId        Int        @map("image_asset_id")
  sortOrder           Int        @map("sort_order") @db.SmallInt
  noPersonConfirmedAt DateTime   @map("no_person_confirmed_at") @db.Timestamptz(6)
  enteredAt           DateTime   @default(now()) @map("entered_at") @db.Timestamptz(6)

  candidate           Candidate  @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  imageAsset          ImageAsset @relation(fields: [imageAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([candidateId, inputNo, sortOrder])
  @@unique([candidateId, inputNo, imageAssetId])
  @@map("thumbnail_reference_input")
}

/// ⑤ 버전의 G3 선택 결과(체크리스트·'같은 상품·색상' 확인)
model ThumbnailSelection {
  id                          Int                       @id @default(autoincrement())
  stepRunId                   Int                       @unique @map("step_run_id")
  checklist                   Json
  sameProductColorConfirmedAt DateTime?                 @map("same_product_color_confirmed_at") @db.Timestamptz(6)
  selectedAt                  DateTime                  @map("selected_at") @db.Timestamptz(6)

  stepRun                     StepRun                   @relation(fields: [stepRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  images                      ThumbnailSelectionImage[]

  @@map("thumbnail_selection")
}

/// G3 선택본에 들어간 이미지(대표 1장 + 추가 0~9장)
model ThumbnailSelectionImage {
  id                   Int                @id @default(autoincrement())
  thumbnailSelectionId Int                @map("thumbnail_selection_id")
  imageAssetId         Int                @map("image_asset_id")
  role                 String             @db.VarChar(16)
  sortOrder            Int                @map("sort_order") @db.SmallInt

  thumbnailSelection   ThumbnailSelection @relation(fields: [thumbnailSelectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  imageAsset           ImageAsset         @relation(fields: [imageAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([thumbnailSelectionId, sortOrder])
  @@unique([thumbnailSelectionId, imageAssetId])
  @@map("thumbnail_selection_image")
}

// ───────────────────────── content — ⑥ 상세 콘텐츠·고시 ─────────────────────────

/// ⑥-1 카피 StepRun 버전의 산출물(1:1)
model ContentDraftCopy {
  id            Int      @id @default(autoincrement())
  stepRunId     Int      @unique @map("step_run_id")
  generatedCopy Json     @map("generated_copy")
  copy          Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  stepRun       StepRun  @relation(fields: [stepRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)

