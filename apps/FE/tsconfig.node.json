{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // 설정 파일 + Node 환경 테스트(// @vitest-environment node, tsconfig.app.json에서 뺀 것)
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "src/app/eslint-boundaries.test.ts",
    "src/app/source-rules.test.ts",
    "src/shared/ui/structure.test.ts",
    "src/shared/ui/tokens-only.test.ts"
  ]
}
